	$(MAKE) $(MAKESILENT) -f CMakeFiles/smart_granary_detect_system.dir/build.make CMakeFiles/smart_granary_detect_system.dir/driver/voltage_sensor.c.s
.PHONY : driver/voltage_sensor.c.s

main.o: main.c.o
.PHONY : main.o

# target to build an object file
main.c.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/smart_granary_detect_system.dir/build.make CMakeFiles/smart_granary_detect_system.dir/main.c.o
.PHONY : main.c.o

main.i: main.c.i
.PHONY : main.i

# target to preprocess a source file
main.c.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/smart_granary_detect_system.dir/build.make CMakeFiles/smart_granary_detect_system.dir/main.c.i
.PHONY : main.c.i

main.s: main.c.s
.PHONY : main.s

# target to generate assembly for a file
main.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/smart_granary_detect_system.dir/build.make CMakeFiles/smart_granary_detect_system.dir/main.c.s
.PHONY : main.c.s

